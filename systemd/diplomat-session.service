[Unit]
Description=Idle Claude Code session for this node (diplomat)
After=network-online.target

[Service]
Type=forking
# One session per node. Put the CLAUDE.md template (diplomat template) in WorkingDirectory.
WorkingDirectory=%h/diplomat
# Optional overrides: ALARM_FILE, DIPLOMAT_INBOX, DIPLOMAT_HEAVY_SLICE
EnvironmentFile=-%h/.config/diplomat/env
# Claude Code is interactive and needs a terminal, so the session runs inside a detached tmux.
# Attach with: tmux attach -t diplomat
ExecStart=/usr/bin/tmux new-session -d -s diplomat /usr/bin/env claude --name diplomat-%H
ExecStop=/usr/bin/tmux kill-session -t diplomat
Restart=on-failure
RestartSec=60
Slice=app.slice

[Install]
WantedBy=default.target
